# 完整配置参考：Compose 部署的必填和常用项已放在 docker-compose.yml。
# 仅用 Compose 部署时，无需复制此文件；其他变量可按需加入 environment。
# 也可复制为 config.env，并启用 Compose 中注释的 env_file；同名 environment 配置优先。
# 直接运行 Python 时，复制为 config.env 后填写下面四个必填项。

# 必填：Telegram API Hash、API ID、机器人令牌和所有者数字 ID。
TELEGRAM_API_HASH = ""
TELEGRAM_API_ID = ""
BOT_TOKEN = ""
OWNER_ID = ""

# 通用设置：空白可选项沿用程序默认值。
BOT_UI_LANGUAGE = "zh-CN"
DOWNLOAD_DIR = "/usr/src/app/downloads/"
SUDO_USERS = ""
ALLOWED_CHATS = ""
# 留空时使用 data/state.db，不需要额外部署 MongoDB。
DATABASE_URL = ""
# 自动保存媒体和纯 TG 消息链接，启用时改为 "True"。
AUTO_MIRROR = "False"
LOCAL_MIRROR = "False"
TMDB_API_KEY = ""
TMDB_LANGUAGE = ""
AUTO_DELETE_MESSAGE_DURATION = ""
CMD_INDEX = ""
STATUS_LIMIT = ""
PARALLEL_TASKS = ""
YT_DLP_OPTIONS = ""
EXTENSION_FILTER = ""
NO_TASKS_LOGS = "True"
# Google Drive：使用内置 Drive 功能时按需配置。
GDRIVE_FOLDER_ID = ""
IS_TEAM_DRIVE = "False"
GD_INDEX_URL = ""
VIEW_LINK = ""
# rclone：默认网盘、个人配置、服务账号及传输参数。
DEFAULT_OWNER_REMOTE = ""
DEFAULT_GLOBAL_REMOTE = ""
MULTI_RCLONE_CONFIG = "True"
USE_SERVICE_ACCOUNTS = "False"
SERVICE_ACCOUNTS_REMOTE = ""
REMOTE_SELECTION = "False"
MULTI_REMOTE_UP = "False"
SERVER_SIDE = "True"
RCLONE_COPY_FLAGS = ""
RCLONE_UPLOAD_FLAGS = ""
RCLONE_DOWNLOAD_FLAGS = ""
RC_INDEX_URL = ""
RC_INDEX_PORT = ""
RC_INDEX_USER = ""
RC_INDEX_PASS = ""
# 启动更新：使用镜像升级时保持 UPSTREAM_REPO 留空。
UPSTREAM_REPO = ""
UPSTREAM_BRANCH = ""
# Telegram 上传：分卷、发送方式、日志聊天及可选个人账号会话。
LEECH_SPLIT_SIZE = ""
AS_DOCUMENT = "False"
EQUAL_SPLITS = "False"
LEECH_LOG = ""
BOT_PM = ""
USER_SESSION_STRING = ""
# qBittorrent：网页选种地址、端口及任务超时。
# Compose 中已指定网页端口，此处同名端口不会覆盖 Compose 的 environment。
QB_BASE_URL = ""
QB_SERVER_PORT = ""
WEB_PINCODE = "False"
TORRENT_TIMEOUT = ""
# MEGA：使用对应网盘时填写。
MEGA_EMAIL = ""
MEGA_PASSWORD = ""
# JDownloader：使用对应下载器时填写。
JD_EMAIL = ""
JD_PASSWORD = ""
# 并发限制：0 表示不限制，可分别限制全部任务、下载和上传。
QUEUE_ALL = "0"
QUEUE_DOWNLOAD = "0"
QUEUE_UPLOAD = "0"
# 文件名替换，格式：old::new|old2::new2。
NAME_SUBSTITUTE = ""
# 动态上传路径模板，可用变量：
# {username}, {user_id}, {date}, {year}, {month}, {day}, {category}, {task_type}
# 示例："remote:/{username}/{category}/{date}/"
UPLOAD_PATH_TEMPLATE = ""
# 种子搜索：搜索服务地址、结果数量及搜索插件。
SEARCH_API_LINK = ""
SEARCH_LIMIT = ""
SEARCH_PLUGINS = ""
